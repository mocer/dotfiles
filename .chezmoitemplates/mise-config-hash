{{- /*
  One sha256 over every mise configuration file in the source directory:
  config.toml* and conf.d/*.toml*, so the .tmpl files are included. Files are
  hashed in sorted order, so the result does not depend on glob order.
  Embedded in run_onchange_ scripts so they re-run when any of them changes.
  Reads the source directory, so it works on every machine, profile files included.
*/ -}}
{{- $mise := joinPath .chezmoi.sourceDir "dot_config" "mise" | replace "\\" "/" -}}
{{- $files := concat (glob (printf "%s/config.toml*" $mise)) (glob (printf "%s/conf.d/*.toml*" $mise)) | sortAlpha -}}
{{- $all := "" -}}
{{- range $files -}}
{{-   $all = print $all (include . | sha256sum) -}}
{{- end -}}
{{- $all | sha256sum -}}
