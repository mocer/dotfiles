# Chezmoi profiles management
#
#

{{- $poste := has "poste" .profiles }}
{{- $arns := and $poste (get .bedrock "opus_arn") (get .bedrock "sonnet_arn") (get .bedrock "haiku_arn") }}
{{ if not $poste -}}
.config/mise/conf.d/poste.toml
.aws/config
claude-code-with-bedrock
.claude/settings.json
{{ else if not $arns -}}
.claude/settings.json
{{ end -}}
{{ if not (has "mobile" .profiles) -}}
.config/mise/conf.d/mobile.toml
{{ end -}}

# Per-OS configuration locations (one shared template, one target per OS)
{{ if ne .chezmoi.os "darwin" -}}
Library
{{ end -}}
{{ if ne .chezmoi.os "windows" -}}
AppData
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
.config/nushell
{{ end -}}
{{ if eq .chezmoi.os "windows" -}}
.config/nushell
.config/alacritty
.config/zed
.config/helix
.config/gh
.config/mpv
.config/fish
{{ end -}}

