# This file is rendered by chezmoi into ~/.cargo/config.toml.
#
# The template keeps Cargo configuration consistent across macOS, Linux,
# and Windows while still selecting values that depend on the local platform.
# Chezmoi provides the operating system and CPU architecture automatically
# through .chezmoi.os and .chezmoi.arch, so those values must not be duplicated
# in machine-local data.
#
# Design policy:
# - macOS builds for the native Apple target.
# - cargo_jobs is optional and can be set per machine in the local
#   ~/.config/chezmoi/chezmoi.toml file under [data].

[build]
# Limit parallel compilation only when an explicit per-machine policy exists.
# If cargo_jobs is absent, this setting is omitted and Cargo selects its normal
# default concurrency based on the available machine resources.
#
# Example local override in ~/.config/chezmoi/chezmoi.toml:
# [data]
# cargo_jobs = 8
{{- if hasKey . "cargo_jobs" }}
jobs = {{ .cargo_jobs }}
{{- end }}

# Route rustc invocations through sccache so compilation artifacts can be reused
# across compatible builds and projects. Always set: sccache is declared in the
# mise configuration, and templates render before any run script, so a lookPath
# check would pick the wrong branch on a fresh machine. The stable link in
# ~/.local/bin is maintained by scripts/refresh-links.nu and works from any
# environment (Zed, GUI applications, scripts).
rustc-wrapper = {{ joinPath .chezmoi.homeDir ".local" "bin" (ternary "sccache.exe" "sccache" (eq .chezmoi.os "windows")) | toJson }}

# Shared target directory for every project, independent of the shell environment.
target-dir = {{ joinPath .chezmoi.homeDir ".cargo" "target" | toJson }}

[env]
SCCACHE_DIR = {{ joinPath .chezmoi.homeDir ".cache" "sccache" | toJson }}
SCCACHE_CACHE_SIZE = {{ get . "sccache_cache_size" | default "50G" | toJson }}
