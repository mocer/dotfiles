#!/usr/bin/env bash

# Maintain a stable user-level path to the Fish binary managed by mise.
#
# Native GUI applications such as Alacritty and Zed do not necessarily inherit
# the shell environment initialized by mise. They should use this stable path
# instead of:
#
# - the version-specific mise installation path, which changes after upgrades;
# - a mise shim, which still depends on mise runtime resolution.
#
# Run this script after installing or upgrading Fish through mise.

set -euo pipefail

readonly link_path="${HOME}/.local/bin/fish"
readonly link_dir="${link_path%/*}"

if ! command -v mise >/dev/null 2>&1; then
    printf 'ERROR: mise is not available in PATH.\n' >&2
    exit 1
fi

fish_path="$(mise which fish 2>/dev/null || true)"

if [[ -z "${fish_path}" ]]; then
    printf 'ERROR: mise could not resolve the active Fish binary.\n' >&2
    printf 'Install or activate Fish through the global mise configuration.\n' >&2
    exit 1
fi

if [[ ! -x "${fish_path}" ]]; then
    printf 'ERROR: the Fish binary resolved by mise is not executable:\n' >&2
    printf '  %s\n' "${fish_path}" >&2
    exit 1
fi

mkdir -p "${link_dir}"

if [[ -e "${link_path}" && ! -L "${link_path}" ]]; then
    printf 'ERROR: refusing to replace a non-symlink path:\n' >&2
    printf '  %s\n' "${link_path}" >&2
    exit 1
fi

current_target="$(readlink "${link_path}" 2>/dev/null || true)"

if [[ "${current_target}" == "${fish_path}" && -x "${link_path}" ]]; then
    printf 'Fish link is already current:\n'
    printf '  %s -> %s\n' "${link_path}" "${fish_path}"
    "${link_path}" --version
    exit 0
fi

temporary_link="${link_path}.new"

rm -f "${temporary_link}"
ln -s "${fish_path}" "${temporary_link}"
mv -f "${temporary_link}" "${link_path}"

resolved_path="$(readlink "${link_path}" 2>/dev/null || true)"

if [[ "${resolved_path}" != "${fish_path}" ]]; then
    printf 'ERROR: the Fish link does not point to the expected target.\n' >&2
    printf 'Expected: %s\n' "${fish_path}" >&2
    printf 'Actual:   %s\n' "${resolved_path:-<missing>}" >&2
    exit 1
fi

if [[ ! -x "${link_path}" ]]; then
    printf 'ERROR: the updated Fish link is not executable:\n' >&2
    printf '  %s\n' "${link_path}" >&2
    exit 1
fi

printf 'Fish link updated successfully:\n'
printf '  %s -> %s\n' "${link_path}" "${resolved_path}"

"${link_path}" --version

