# This file is rendered by chezmoi into ~/.config/cargo/config.toml.
#
# The template keeps Cargo configuration consistent across macOS, Linux,
# and WSL2 while still selecting values that depend on the local platform.
# Chezmoi provides the operating system and CPU architecture automatically
# through .chezmoi.os and .chezmoi.arch, so those values must not be duplicated
# in machine-local data.
#
# Design policy:
# - macOS builds for the native Apple target.
# - cargo_jobs is optional and can be set per machine in the local
#   ~/.config/chezmoi/chezmoi.toml file under [data].

[registries]
# Use Cargo's sparse registry protocol to avoid downloading the full crates.io
# index and reduce registry update overhead.
registries.crates-io.protocol = "sparse"

[build]
# Limit parallel compilation only when an explicit per-machine policy exists.
# If cargo_jobs is absent, this setting is omitted and Cargo selects its normal
# default concurrency based on the available machine resources.
#
# Example local override in ~/.config/chezmoi/chezmoi.toml:
# [data]
# cargo_jobs = 8
{{- if hasKey . "cargo_jobs" }}
jobs = {{ .cargo_jobs }}
{{- end }}

# Route rustc invocations through sccache so compilation artifacts can be reused
# across compatible builds and projects. The sccache executable must be
# available outside interactive shells as well, for example through a stable
# shim or symlink managed during machine setup.
{{- if lookPath "sccache" }}
rustc-wrapper = "sccache"
{{- end }}
