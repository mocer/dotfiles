{{- /*
  Zed settings.

  Data sources:
  - .chezmoidata/bedrock.toml       shared defaults (region, profile)
  - ~/.config/chezmoi/chezmoi.toml  profiles, personal inference profile ARNs

  Profile "poste" enables: GitHub Enterprise Copilot, Claude Agent (ACP) and the
  native Bedrock provider. Bedrock blocks are rendered only when all ARNs exist.

  Zed rewrites this file when settings are changed from the UI: run
  `chezmoi diff` and bring the changes back into this template.
*/ -}}
{{- $poste := has "poste" .profiles -}}
{{- $b := .bedrock -}}
{{- $bedrock := and $poste (get $b "opus_arn") (get $b "sonnet_arn") (get $b "haiku_arn") -}}
// Zed settings — managed by chezmoi, edit the template instead.
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
{{- if $bedrock }}
  // Claude Code through ACP: reads ~/.claude/settings.json (Bedrock + ARNs).
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
{{- end }}
{{- if $poste }}
  "copilot": {
    "enterprise_uri": "https://posteitaliane.ghe.com",
  },
{{- end }}
{{- if ne .chezmoi.os "windows" }}
  "terminal": {
    "shell": {
      "program": {{ joinPath .chezmoi.homeDir ".local" "bin" "fish" | toJson }},
    },
  },
{{- end }}
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
{{- if $bedrock }}
    "default_model": {
      "provider": "amazon-bedrock",
      "model": {{ $b.sonnet_arn | toJson }},
      "enable_thinking": false,
    },
{{- end }}
    "dock": "right",
    "favorite_models": [
{{- if $bedrock }}
      { "provider": "amazon-bedrock", "model": {{ $b.opus_arn | toJson }},   "enable_thinking": true },
      { "provider": "amazon-bedrock", "model": {{ $b.sonnet_arn | toJson }}, "enable_thinking": true },
      { "provider": "amazon-bedrock", "model": {{ $b.haiku_arn | toJson }},  "enable_thinking": true },
{{- end }}
      { "provider": "google", "model": "gemini-3.5-flash",       "enable_thinking": true, "effort": "medium" },
      { "provider": "google", "model": "gemini-3.1-pro-preview", "enable_thinking": true, "effort": "high" },
    ],
    "model_parameters": [],
  },
  "agent_buffer_font_size": 16,
  "auto_signature_help": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 16,
  "colorize_brackets": true,
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot",
  },
  "helix_mode": true,
  "inlay_hints": {
    "enabled": true,
  },
  "languages": {
    "Rust": {
      "document_symbols": "on",
    },
    "Dockerfile": {
      "document_symbols": "on",
    },
    "JSON": {
      "document_symbols": "off",
    },
  },
{{- if $bedrock }}
  // Native Bedrock provider: chat and inline assist only. Zed does not
  // enable tools for custom inference profile ARNs; use Claude Agent for edits.
  "language_models": {
    "bedrock": {
      "authentication_method": "named_profile",
      "profile": {{ $b.profile | toJson }},
      "region": {{ $b.region | toJson }},
      "allow_global": false,
      "available_models": [
        { "name": {{ $b.opus_arn | toJson }},   "display_name": "Claude Opus 4.7",   "max_tokens": 200000, "max_output_tokens": 16000 },
        { "name": {{ $b.sonnet_arn | toJson }}, "display_name": "Claude Sonnet 4.6", "max_tokens": 200000, "max_output_tokens": 16000 },
        { "name": {{ $b.haiku_arn | toJson }},  "display_name": "Claude Haiku 4.5",  "max_tokens": 200000, "max_output_tokens": 16000 },
      ],
    },
  },
{{- end }}
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "env": {
          "SQLX_OFFLINE": "true",
        },
      },
      "initialization_options": {
        "inlayHints": {
          "closureReturnTypeHints": {
            "enable": "always",
          },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "cargo": { "targetDir": true },
        },
      },
    },
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
  },
  "relative_line_numbers": "enabled",
  "theme": {
    "dark": "One Dark",
    "light": "One Light",
    "mode": "system",
  },
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 18,
}

