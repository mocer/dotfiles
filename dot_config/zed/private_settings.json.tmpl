// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "shell": {
     "program": "{{ .chezmoi.homeDir }}/.local/bin/fish"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [
      {
        "provider": "amazon-bedrock",
        "model": "arn:aws:bedrock:eu-central-1:190734623145:application-inference-profile/w6vvp7ux999n",
        "enable_thinking": true
      },
      {
        "provider": "amazon-bedrock",
        "model": "arn:aws:bedrock:eu-central-1:190734623145:application-inference-profile/xb0nk2qysau9",
        "enable_thinking": true
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-4.1",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": false
      },
      {
        "provider": "google",
        "model": "gemini-3.5-flash",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "google",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "default_model": {
      "effort": "medium",
      "provider": "google",
      "model": "gemini-3.5-flash",
      "enable_thinking": true,
    },
    "model_parameters": [],
    "default_profile": "ask",
  },
  "agent_buffer_font_size": 16,
  "auto_signature_help": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 16,
  "colorize_brackets": true,
  "edit_predictions": {
    "copilot": {
      "enterprise_uri": "https://posteitaliane.ghe.com",
    },
    "mode": "eager",
    "provider": "copilot",
  },
  "helix_mode": true,
  "inlay_hints": {
    "enabled": true,
  },
  "languages": {
    "Rust": {
      "document_symbols": "on",
    },
    "Dockerfile": {
      "document_symbols": "on",
    },
    "JSON": {
      "document_symbols": "off",
    },
  },
  "language_models": {
    "bedrock": {
      "authentication_method": "api_key",
      "allow_global": false,
      "allow_extended_context": true,
      "region": "eu-central-1",
      "available_models": [
        {
          "name": "arn:aws:bedrock:eu-central-1:190734623145:application-inference-profile/xb0nk2qysau9",
          "display_name": "Claude Sonnet (PCLS)",
          "max_tokens": 4096,
          "max_output_tokens": 16000,
        },
        {
          "name": "arn:aws:bedrock:eu-central-1:190734623145:application-inference-profile/w6vvp7ux999n",
          "display_name": "Claude Opus (PCLS)",
          "max_tokens": 4096,
          "max_output_tokens": 16000,
        },
      ],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "env": {
          "SQLX_OFFLINE": "true",
        },
      },
      "initialization_options": {
        "inlayHints": {
          "closureReturnTypeHints": {
            "enable": "always",
          },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
        },
      },
    },
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
  },
  "relative_line_numbers": "enabled",
  "theme": {
    "dark": "One Dark",
    "light": "One Light",
    "mode": "system",
  },
  "ui_font_family": "FiraCode Nerd Font",
  "ui_font_size": 18,
}
