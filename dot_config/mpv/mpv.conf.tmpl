{{- /*
  mpv configuration.

  Data sources:
  - .chezmoidata/mpv.toml           shared defaults
  - ~/.config/chezmoi/chezmoi.toml  per-OS override of hardware_decoding
                                    (generated by .chezmoi.toml.tmpl)
*/ -}}
{{- $m := .mpv -}}
{{- range $k := list "video_output" "hardware_decoding" "profile" "demuxer_max_bytes" "demuxer_readahead_seconds" "scale" "chroma_scale" "downscale" "video_sync" "subtitle_auto" "audio_file_auto" }}
{{-   if not (hasKey $m $k) }}{{ fail (printf "mpv.%s missing: check .chezmoidata/mpv.toml" $k) }}{{ end }}
{{- end -}}
# --- Hardware Decoding & Rendering ---
vo={{ $m.video_output }}
hwdec={{ $m.hardware_decoding }}
profile={{ $m.profile }}

# --- Memory & Cache ---
demuxer-max-bytes={{ $m.demuxer_max_bytes }}
demuxer-readahead-secs={{ $m.demuxer_readahead_seconds }}

# --- Video Scaling & Display ---
scale={{ $m.scale }}
cscale={{ $m.chroma_scale }}
dscale={{ $m.downscale }}
video-sync={{ $m.video_sync }}
interpolation={{ ternary "yes" "no" (get $m "interpolation" | default false) }}

# --- Subtitles & Audio ---
sub-auto={{ $m.subtitle_auto }}
audio-file-auto={{ $m.audio_file_auto }}
