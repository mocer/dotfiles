{{- /*
  Nushell environment, loaded before config.nu.

  Shell-scoped variables live here. Tool configuration that must also be
  visible to GUI apps (Zed) lives in tool config files and is only mirrored:
  - ~/.cargo/config.toml  target-dir, rustc-wrapper, [env] SCCACHE_*
*/ -}}
{{- $win := eq .chezmoi.os "windows" -}}
{{- $shims := ternary (joinPath (env "LOCALAPPDATA") "mise" "shims") (joinPath .chezmoi.homeDir ".local" "share" "mise" "shims") $win -}}
{{- $cargoConfig := joinPath .chezmoi.homeDir ".cargo" "config.toml" -}}
{{- $ghrRoot := get . "ghr_root" | default "~/Repos" -}}
{{- if hasPrefix "~/" $ghrRoot }}{{ $ghrRoot = joinPath .chezmoi.homeDir (trimPrefix "~/" $ghrRoot) }}{{ end -}}
# Managed by chezmoi: edit env.nu.tmpl in the dotfiles repository.

# ── PATH ─────────────────────────────────────────────────────────────
# mise shims first, then user and cargo binaries. System paths come from the OS.
$env.PATH = ($env.PATH
  | split row (char esep)
  | prepend [
      {{ $shims | toJson }}
      {{ joinPath .chezmoi.homeDir ".local" "bin" | toJson }}
      {{ joinPath .chezmoi.homeDir ".cargo" "bin" | toJson }}
    ]
  | uniq)

# ── Rust ─────────────────────────────────────────────────────────────
# Panic backtraces for binaries started from the shell.
$env.RUST_BACKTRACE = "1"

# ── sccache ──────────────────────────────────────────────────────────
# Single source of truth: [env] in ~/.cargo/config.toml.
# Mirrored here so a server started from the shell gets the same values.
if ({{ $cargoConfig | toJson }} | path exists) {
  open {{ $cargoConfig | toJson }}
  | get env?
  | default {}
  | transpose key value
  | where {|row| ($row.key | str starts-with "SCCACHE_") and (($row.value | describe) == "string") }
  | reduce --fold {} {|row, acc| $acc | insert $row.key $row.value }
  | load-env
}

# ── Tools ────────────────────────────────────────────────────────────
$env.GHR_ROOT = {{ $ghrRoot | toJson }}
$env._ZO_FZF_OPTS = ""
$env._ZOXIDE_FZF_CMD = "sk --height 40% --layout=reverse --border rounded"
{{- if not $win }}
$env.MANPAGER = "sh -c 'col -bx | bat -l man -p'"
{{- end }}

# ── Locale ───────────────────────────────────────────────────────────
$env.LANG = {{ get . "locale" | default "it_IT.UTF-8" | toJson }}
