{{- $shims := ternary (joinPath (env "LOCALAPPDATA") "mise" "shims") (joinPath .chezmoi.homeDir ".local" "share" "mise" "shims") (eq .chezmoi.os "windows") -}}
{{- $exe := ternary "credential-process.exe" "credential-process" (eq .chezmoi.os "windows") -}}
[profile {{ .bedrock.profile }}]
credential_process = {{ joinPath $shims $exe | quote }} --profile {{ .bedrock.profile }}
region = {{ .bedrock.region }}
