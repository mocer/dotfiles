{{- /*
  AWS shared config for Amazon Bedrock (profile "poste").

  Data sources:
  - .chezmoidata/bedrock.toml  shared defaults (region, profile)

  credential_process runs the company credential-process binary, which reads
  ~/claude-code-with-bedrock/config.json (deployed by chezmoi from
  claude-code-with-bedrock/encrypted_config.json.age).
*/ -}}
{{- $b := .bedrock -}}
{{- $cp := includeTemplate "credential-process-path" . -}}
[profile {{ $b.profile }}]
credential_process = {{ $cp | quote }} --profile {{ $b.profile }}
region = {{ $b.region }}
