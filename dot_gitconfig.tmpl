# This is Git's per-user configuration file.
# This is also the fallback to ghr failures 
[user]
	name = Mocer Andari
	email = mocer.andari@gmail.com
	signingkey = ~/.ssh/id_ed25519_developer.pub

# Force Git to use SSH instead of GPG for signing
[gpg]
	format = ssh

# REQUIRED: Tell Git where your allowed_signers file is
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
{{- if eq .chezmoi.os "windows" }}
	# Windows OpenSSH, not the one bundled with Git for Windows: KeePassXC loads the keys
	# into the ssh-agent service of Windows. Same reason for core.sshCommand below.
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
{{- end }}

# Enable automatic signing for every commit
[commit]
	gpgsign = true

# Global gitignore for machine and user-specific artifacts
[core]
	excludesFile = ~/.config/git/ignore
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
